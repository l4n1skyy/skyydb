# Your data stays out of git: the databases, SQLite's side files and the backups
*.db
*.db-journal
*.db-wal
*.db-shm
backups/
__pycache__/
features

# Settings from the Settings page (page names, locks, the password hash)
settings.json
settings.json.tmp

# The scrapers' own output: your eLearn crawl and stream, Strava's probe answers (personal)
scrapers/*/dump/
scrapers/elearn/stream.html
scrapers/elearn/stream.json
